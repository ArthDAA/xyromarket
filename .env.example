# Copy to `.env` on the VPS and fill in real values. Never commit the real
# file (already in .gitignore). See README.md > "Déploiement" for the full
# procedure and README.md > "Configuration Discord" for where the Discord
# values come from.
#
# NODE_ENV=production skips the auto-load of this file (src/config/env.js) —
# on the VPS, these keys must be exported into the process environment
# directly. The systemd units in deploy/systemd/*.service do this via
# `EnvironmentFile=/opt/xyro-market/.env`, which is the one place this file
# actually gets read from in production.

# postgres://user:password@host:port/database — the xyro_app role, not a superuser.
DATABASE_URL=postgres://xyro_app:CHANGE_ME@localhost:5432/xyro_prod

# Discord Developer Portal > Application > OAuth2 (Client ID/Secret) and Bot (Token).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
# The hub server's Discord ID (right-click the server icon > Copier l'ID, developer mode on).
DISCORD_HUB_GUILD_ID=

# Random, >=32 chars. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never reuse the same value for both — they guard different things (session
# signing vs. encrypting stored OAuth tokens) and must be independent secrets.
SESSION_SECRET=
# Must be base64 and decode to exactly 32 bytes. Generate with the same
# command as SESSION_SECRET above (32 random bytes, base64-encoded).
TOKEN_ENC_KEY=

# The real public URL of the deployed site, https:// required (http only
# works for localhost, which is never a production target).
PUBLIC_BASE_URL=https://xyro.market

NODE_ENV=production
WEB_PORT=3000
LOG_LEVEL=info
